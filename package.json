{
  "name": "commerce-ops-mcp",
  "version": "1.0.0",
  "description": "AI-native commerce operations MCP server: verified-carrier-exception refund resolution",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
