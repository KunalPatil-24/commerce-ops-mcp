# Copy to .env for local overrides. Local dev needs none of these:
# it defaults to postgresql://localhost:5432/commerce_ops with no SSL.

# Full Postgres connection string. Hosting platforms and Neon provide this.
# Example (Neon): postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Force SSL on. Not needed when DATABASE_URL already contains sslmode=require
# (that is auto-detected). Leave unset for local Postgres.
DATABASE_SSL=

# HTTP port. Hosting platforms set this automatically; local defaults to 3000.
PORT=
